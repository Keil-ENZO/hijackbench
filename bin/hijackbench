#!/bin/sh
# Runs the hijackbench CLI in Docker, on the same data volume as the
# campaigns, from any directory or over SSH:
#
#   ssh enzo@homelab-01 '~/Developer/hijackbench/bin/hijackbench stop'
#
# A TTY is only asked for when there is one, so SSH without -t works.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
tty=-T
[ -t 0 ] && [ -t 1 ] && tty=
exec docker compose --project-directory "$repo" -f "$repo/docker-compose.yml" run --rm $tty hijackbench "$@"
